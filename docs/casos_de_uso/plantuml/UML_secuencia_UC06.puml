@startuml UML_secuencia_UC06
skinparam monochrome true
skinparam dpi 300
skinparam defaultFontName Arial
skinparam sequenceMessageAlign center
skinparam maxMessageSize 180
skinparam responseMessageBelowArrow true
skinparam BoxPadding 10
skinparam ParticipantPadding 10

header
<b>Integrantes:</b> Aguilar Castellon Cristhian Alessandro, Aramayo Eguino Jose Matias, Rosales Mamani Ariel Edson
endheader

title Diagrama de Secuencia DS-02 (UC-06 / UC-07): Traducción Braille Grado 1, Generación de G-Code y Solicitud de Pedido\n(Validación Código Braille Español ONCE, Transacción Atómica y Almacenamiento G-Code)

actor "Usuario\nSolicitante" as S
boundary "Catálogo / Formulario\n(Blade UI)" as UI
control "PedidoController\n(Laravel Controller)" as PC
control "StorePedidoRequest\n(Validador / Sanitizer)" as PR
control "PedidoService\n(App\\Services)" as PS
control "BrailleTranslator\n(App\\Services / PHP)" as BT
database "MySQL 8.0\n(Eloquent ORM)" as DB
entity "Storage Local\n(Disco Privado)" as ST

autonumber 1 "<b>[00]</b>"

S -> UI : Selecciona recurso del catálogo\ny pulsa «Solicitar Impresión»
activate S
activate UI

UI -> PC : GET /pedidos/crear?recurso={id}
activate PC
PC -> DB : SELECT * FROM recursos WHERE id = ? AND estado = 'Activo'
activate DB
DB --> PC : Datos del recurso (peso base, dimensiones, z_altura)
deactivate DB
PC -> DB : SELECT * FROM instituciones WHERE activo = 1
activate DB
DB --> PC : Lista de instituciones asociadas
deactivate DB
PC --> UI : Formulario de solicitud cargado
deactivate PC
UI --> S : Renderiza interfaz de solicitud (parámetros y texto opcional)
deactivate UI

S -> UI : Completa formulario (institución, cantidad,\ntexto personalizado opcional) y pulsa «Confirmar Solicitud»
activate UI
UI -> PC : POST /pedidos\n(recurso_id, institucion_id, cantidad, texto_personalizado)
activate PC

PC -> PR : validateResolved()\n(Reglas de validación, sanitización y chequeo de caracteres Braille)
activate PR

opt Con texto personalizado (Personalización de Ficha)
    PR -> BT : validarCaracteres(texto_personalizado)
    activate BT
    BT --> PR : Lista de caracteres no válidos []
    deactivate BT

    alt Contiene caracteres no soportados en Braille Grado 1
        PR --> PC : ValidationException (422 Unprocessable Entity)
        PC --> UI : Retorna errores: «Caracteres no soportados: @, #. Solo Braille Español.»
        UI --> S : Muestra alerta de validación al solicitante
    end
end

PR --> PC : Datos validados y sanitizados
deactivate PR

PC -> PS : crearPedido(datos_validados, auth_user_id)
activate PS

PS -> DB : DB::beginTransaction()
activate DB
deactivate DB

PS -> PS : calcularCostos(recurso, cantidad, texto_personalizado)
activate PS
opt Si existe texto personalizado
    PS -> BT : traducir(texto_personalizado)
    activate BT
    BT --> PS : Array de celdas Braille traducidas (puntos 1-6)
    deactivate BT
    PS -> PS : Calcula filamento adicional (celdas * 0.02g)
end
PS --> PS : {gramos_totales, costo_unitario, costo_total}
deactivate PS

PS -> DB : INSERT INTO pedidos (user_id, institucion_id, estado='Pendiente', fecha_solicitud=NOW(), total_gramos_pla, costo_total)
activate DB
DB --> PS : pedido_id generado
deactivate DB

PS -> DB : INSERT INTO detalle_pedidos (pedido_id, recurso_id, cantidad, gramos_pla, costo_unitario)
activate DB
DB --> PS : detalle_id generado
deactivate DB

opt Si incluye texto personalizado (Generación de G-Code a medida)
    PS -> PS : generarYGuardarGCode(pedido, recurso, texto_personalizado)
    activate PS
    PS -> BT : generarGCode(texto, offsetX=5.0, offsetY=5.0, z=placa_z_altura, config)
    activate BT
    BT --> PS : Contenido G-Code estructurado (G21, G28, G1 X... Y... E...)
    deactivate BT

    PS -> ST : Storage::disk('local')->put('pedidos/gcode/pedido_{id}_{hash}.gcode', gcode)
    activate ST
    ST --> PS : gcode_path guardado exitosamente
    deactivate ST

    PS -> DB : UPDATE pedidos SET gcode_path = ? WHERE id = ?
    activate DB
    DB --> PS : Pedido actualizado con ruta G-Code
    deactivate DB
    deactivate PS
end

PS -> DB : DB::commit()
activate DB
deactivate DB

PS --> PC : Instancia de Pedido registrado
deactivate PS

PC --> UI : Response 302 → Redirect /pedidos/{id}/checkout\n(Mensaje Flash: «Solicitud registrada correctamente»)
deactivate PC
UI --> S : Renderiza pantalla de Checkout / Factura Proforma con QR de confirmación
deactivate UI
deactivate S

center footer Fuente: Elaboración propia, 2026.

@enduml
