@startuml UC10_Reportes_Estadisticas
title UC-10: Reportes y Estadísticas

skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white

left to right direction

actor "Administrador" as A

rectangle "Sistema Braille Inclusivo" {
    usecase "Exportar recursos a PDF" as UC10a
    usecase "Exportar recursos a Excel" as UC10b
    usecase "Exportar instituciones a PDF" as UC10c
    usecase "Exportar instituciones a Excel" as UC10d
    usecase "Exportar usuarios a PDF" as UC10e
    usecase "Exportar usuarios a Excel" as UC10f
    usecase "Exportar pedidos a PDF" as UC10g
    usecase "Exportar pedidos a Excel" as UC10h
    usecase "Ver estadísticas de consumo PLA\n[PENDIENTE]" as UC10i
    usecase "Ver gráfico de pedidos por estado\n[PENDIENTE]" as UC10j
    usecase "Ver historial de pedidos" as UC10k
}

A --> UC10a
A --> UC10b
A --> UC10c
A --> UC10d
A --> UC10e
A --> UC10f
A --> UC10g
A --> UC10h
A --> UC10i
A --> UC10j
A --> UC10k

@enduml
