@startuml UC05_Gestionar_Usuarios
title UC-05: Gestionar Usuarios

skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white

left to right direction

actor "Administrador" as A

rectangle "Sistema Braille Inclusivo" {
    usecase "Ver lista de usuarios" as UC05a
    usecase "Crear nuevo usuario" as UC05b
    usecase "Editar usuario" as UC05c
    usecase "Eliminar usuario (papelera)" as UC05d
    usecase "Ver papelera de usuarios" as UC05e
    usecase "Restaurar usuario" as UC05f
    usecase "Eliminar permanentemente" as UC05g
    usecase "Validar datos de usuario" as UC05h
    usecase "Asignar rol (Solicitante/Admin)" as UC05i
    usecase "Encriptar contraseña" as UC05j
    usecase "Almacenar foto de perfil" as UC05k
}

A --> UC05a
A --> UC05b
A --> UC05c
A --> UC05d
A --> UC05e
A --> UC05f
A --> UC05g

UC05b ..> UC05h : <<include>>
UC05b ..> UC05i : <<include>>
UC05b ..> UC05j : <<include>>
UC05c ..> UC05h : <<include>>
UC05k ..> UC05b : <<extend>>

@enduml
