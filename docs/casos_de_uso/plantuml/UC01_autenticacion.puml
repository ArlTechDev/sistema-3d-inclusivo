@startuml UC01_Autenticacion
title UC-01: Iniciar / Cerrar Sesión

skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white

left to right direction

actor "Usuario\n(Solicitante o\nAdministrador)" as U

rectangle "Sistema Braille Inclusivo" {
    usecase "Iniciar Sesión" as UC01a
    usecase "Cerrar Sesión" as UC01b
    usecase "Validar Credenciales" as UC01c
    usecase "Mostrar Error de Login" as UC01d
    usecase "Redirigir al Dashboard" as UC01e
    usecase "Invalidar Sesión" as UC01f
}

U --> UC01a
U --> UC01b

UC01a ..> UC01c : <<include>>
UC01d ..> UC01a : <<extend>>
UC01e ..> UC01a : <<extend>>
UC01b ..> UC01f : <<include>>

@enduml
