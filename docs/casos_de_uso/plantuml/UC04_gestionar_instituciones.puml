@startuml UC04_Gestionar_Instituciones
title UC-04: Gestionar Instituciones

skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white

left to right direction

actor "Administrador" as A

rectangle "Sistema Braille Inclusivo" {
    usecase "Ver lista de instituciones" as UC04a
    usecase "Crear nueva institución" as UC04b
    usecase "Editar institución" as UC04c
    usecase "Eliminar institución (papelera)" as UC04d
    usecase "Ver papelera de instituciones" as UC04e
    usecase "Restaurar institución" as UC04f
    usecase "Eliminar permanentemente" as UC04g
    usecase "Validar datos de institución" as UC04h
    usecase "Almacenar logo y PDF" as UC04i
}

A --> UC04a
A --> UC04b
A --> UC04c
A --> UC04d
A --> UC04e
A --> UC04f
A --> UC04g

UC04b ..> UC04h : <<include>>
UC04b ..> UC04i : <<include>>
UC04c ..> UC04h : <<include>>

@enduml
