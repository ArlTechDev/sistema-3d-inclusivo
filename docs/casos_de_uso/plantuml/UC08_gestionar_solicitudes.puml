@startuml UC08_Gestionar_Solicitudes
title UC-08: Gestionar Solicitudes

skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white

left to right direction

actor "Administrador" as A

rectangle "Sistema Braille Inclusivo" {
    usecase "Ver todas las solicitudes" as UC08a
    usecase "Filtrar por estado o institución" as UC08b
    usecase "Actualizar estado de pedido" as UC08c
    usecase "Cambiar a 'En impresión'" as UC08d
    usecase "Cambiar a 'Completado'" as UC08e
    usecase "Rechazar solicitud" as UC08f
    usecase "Parametrizar costo por gramo de PLA" as UC08g
    usecase "Recalcular costos de pedidos" as UC08h
    usecase "Ver detalle del pedido" as UC08i
    usecase "Agregar motivo de rechazo" as UC08j
}

A --> UC08a
A --> UC08b
A --> UC08c
A --> UC08d
A --> UC08e
A --> UC08f
A --> UC08g
A --> UC08i

UC08d ..> UC08c : <<extend>>
UC08e ..> UC08c : <<extend>>
UC08f ..> UC08c : <<extend>>
UC08f ..> UC08j : <<include>>
UC08g ..> UC08h : <<include>>

@enduml
