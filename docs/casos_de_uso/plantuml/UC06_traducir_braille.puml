@startuml UC06_Traducir_Braille
title UC-06: Traducir Texto a Braille

skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white

left to right direction

actor "Solicitante" as S

rectangle "Sistema Braille Inclusivo" {
    usecase "Ingresar texto en español" as UC06a
    usecase "Validar caracteres Código Braille Español" as UC06b
    usecase "Traducir texto a Braille" as UC06c
    usecase "Mostrar previsión visual 2D\n[PENDIENTE]" as UC06d
    usecase "Mostrar error de validación" as UC06e
    usecase "Limitar longitud de texto" as UC06f
}

S --> UC06a

UC06a ..> UC06b : <<include>>
UC06b ..> UC06c : <<include>>
UC06c ..> UC06d : <<include>>
UC06a ..> UC06f : <<include>>
UC06e ..> UC06b : <<extend>>

@enduml
