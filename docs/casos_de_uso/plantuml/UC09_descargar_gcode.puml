@startuml UC09_Descargar_GCode
title UC-09: Descargar G-Code

skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white

left to right direction

actor "Administrador" as A

rectangle "Sistema Braille Inclusivo" {
    usecase "Seleccionar pedido para descargar" as UC09a
    usecase "Verificar estado del pedido" as UC09b
    usecase "Descargar archivo .gcode" as UC09c
    usecase "Mostrar error si pedido no válido" as UC09d
    usecase "Registrar fecha de descarga" as UC09e
    usecase "Transferir a PC Operador (USB)" as UC09f
    usecase "Cargar en Impresora 3D" as UC09g
}

A --> UC09a

UC09a ..> UC09b : <<include>>
UC09c ..> UC09b : <<extend>>
UC09d ..> UC09b : <<extend>>
UC09c ..> UC09e : <<include>>
UC09f ..> UC09c : <<extend>>
UC09g ..> UC09f : <<extend>>

@enduml
