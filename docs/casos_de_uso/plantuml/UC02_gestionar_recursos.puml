@startuml UC02_Gestionar_Recursos
title UC-02: Gestionar Recursos

skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white

left to right direction

actor "Administrador" as A

rectangle "Sistema Braille Inclusivo" {
    usecase "Ver lista de recursos" as UC02a
    usecase "Crear nuevo recurso" as UC02b
    usecase "Editar recurso existente" as UC02c
    usecase "Eliminar recurso (papelera)" as UC02d
    usecase "Ver papelera de recursos" as UC02e
    usecase "Restaurar recurso" as UC02f
    usecase "Eliminar permanentemente" as UC02g
    usecase "Validar datos del recurso" as UC02h
    usecase "Almacenar archivos" as UC02i
    usecase "Eliminar archivos del disco" as UC02j
}

A --> UC02a
A --> UC02b
A --> UC02c
A --> UC02d
A --> UC02e
A --> UC02f
A --> UC02g

UC02b ..> UC02h : <<include>>
UC02b ..> UC02i : <<include>>
UC02c ..> UC02h : <<include>>
UC02c ..> UC02i : <<include>>
UC02g ..> UC02j : <<include>>

@enduml
