@startuml UC00_Diagrama_General
title UC-00: Diagrama General de Casos de Uso

skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white

left to right direction

actor "Solicitante" as S
actor "Administrador" as A

rectangle "Sistema Braille Inclusivo" {
    usecase "Iniciar / Cerrar Sesión" as UC01a
    usecase "Gestionar Recursos" as UC02
    usecase "Ver Catálogo" as UC03
    usecase "Gestionar Instituciones" as UC04
    usecase "Gestionar Usuarios" as UC05
    usecase "Traducir Texto a Braille" as UC06
    usecase "Solicitar Impresión" as UC07
    usecase "Gestionar Solicitudes" as UC08
    usecase "Descargar G-Code" as UC09
    usecase "Reportes y Estadísticas" as UC10
}

S --> UC01a
S --> UC03
S --> UC06
S --> UC07
A --> UC01a
A --> UC02
A --> UC04
A --> UC05
A --> UC08
A --> UC09
A --> UC10

UC07 ..> UC06 : <<extend>>
UC09 ..> UC07 : <<extend>>

@enduml
