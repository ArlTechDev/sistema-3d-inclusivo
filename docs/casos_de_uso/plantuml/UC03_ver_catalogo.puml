@startuml UC03_Ver_Catalogo
title UC-03: Ver Catálogo de Recursos

skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white

left to right direction

actor "Solicitante" as S

rectangle "Sistema Braille Inclusivo" {
    usecase "Ver catálogo de recursos" as UC03a
    usecase "Filtrar por categoría" as UC03b
    usecase "Buscar por nombre" as UC03c
    usecase "Ver detalle del recurso" as UC03d
    usecase "Ver imagen de referencia" as UC03e
    usecase "Ver tiempo y peso estimados" as UC03f
}

S --> UC03a

UC03b ..> UC03a : <<extend>>
UC03c ..> UC03a : <<extend>>
UC03d ..> UC03a : <<extend>>
UC03d ..> UC03e : <<include>>
UC03d ..> UC03f : <<include>>

@enduml
